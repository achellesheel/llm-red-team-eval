# ── LLM Provider ─────────────────────────────────────────────────────────
# "groq" (free cloud), "ollama" (local), or "openai_compatible"
LLM_PROVIDER=groq

# ── Groq (free tier — get key at https://console.groq.com) ──────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# ── Ollama (local — install from https://ollama.ai) ─────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ── OpenAI-Compatible (any endpoint) ────────────────────────────────────
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# ── Eval Settings ────────────────────────────────────────────────────────
CONTRADICTION_THRESHOLD=0.65


